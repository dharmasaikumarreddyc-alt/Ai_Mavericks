NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Vertex AI runtime. Cloud Run uses its attached service identity automatically.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.8-flash

# Optional for local REST evaluation only: use a short-lived token from
# `gcloud auth print-access-token`. Never commit a real token.
VERTEX_ACCESS_TOKEN=
